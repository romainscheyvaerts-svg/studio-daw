# Environment Variables pour le déploiement
# Copier ce fichier en .env pour le développement local
# Sur Vercel: Settings → Environment Variables

# Supabase (pour l'authentification et le stockage)
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Gemini API (pour les fonctionnalités IA)
GEMINI_API_KEY=your_gemini_api_key_here

# Note: Ces variables sont optionnelles pour tester l'interface
# L'application devrait fonctionner sans elles (mode demo)
